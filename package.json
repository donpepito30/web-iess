{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:fsevents --external:lightningcss --external:esbuild --outfile=dist/server.cjs",
    "smoke": "bash scripts/smoke-vercel.sh",
    "assets": "tsx scripts/make-assets.ts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "seo:check": "tsx scripts/check-seo.ts",
    "seo:chat-topics": "tsx scripts/chat-topics.ts",
    "data:report": "tsx scripts/verify-report.ts",
    "indexnow": "tsx scripts/indexnow.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.18.0",
    "vite": "^6.2.3",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/node": "^12.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "terser": "^5.48.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1"
  }
}
