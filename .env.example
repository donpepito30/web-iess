# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SITE_URL: Enforce primary public site URL (e.g. https://ieesciudadano.vercel.app)
# If defined in production, requests from other domains will be redirected via 301.
SITE_URL="https://ieesciudadano.vercel.app"

# MONETIZATION CONFIGURATION (All ads are disabled by default until network approval)
VITE_ADS_ENABLED="false"
VITE_ADSENSE_CLIENT="ca-pub-0000000000000000"
ADS_TXT="google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0"

